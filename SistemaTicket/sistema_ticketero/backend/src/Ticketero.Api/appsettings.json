{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=TicketeroDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyAtLeast32CharactersLong!",
    "Issuer": "TicketeroAPI",
    "Audience": "TicketeroClient",
    "ExpirationMinutes": 480
  },
  "TicketSettings": {
    "EstimatedWaitMinutes": 5,
    "MaxTicketsPerDay": 500,
    "TicketPrefixFormat": "{0}-{1:D4}"
  }
}
